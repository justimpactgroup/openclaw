{
  "name": "@justimpactgroup/source",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "check": "prettier --check . && nx run-many -t lint typecheck test build validate && npm run check:lockfile",
    "check:project": "nx run-many -t lint typecheck test build validate -p",
    "check:lockfile": "node tools/scripts/check-lockfile.ts",
    "format": "prettier --write .",
    "new-plugin": "node tools/scripts/new-plugin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/devkit": "23.3.0",
    "@nx/js": "23.3.0",
    "@types/node": "^26.6.6",
    "clawhub": "0.25.0",
    "eslint": "^10.14.0",
    "nx": "23.3.0",
    "openclaw": "2026.10.9",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}
